{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["splash"],
  "ios": {
    "iosModuleName": "OsukiSplash"
  },
  "android": {
    "androidNamespace": ["splash"],
    "androidCxxLibName": "OsukiSplash"
  },
  "autolinking": {
    "SplashScreen": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSplashScreen"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSplashScreen"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "example", "lib", "plugin", "cli"]
}
